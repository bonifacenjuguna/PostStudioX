# ── Core Bot ──────────────────────────────
BOT_TOKEN=
OWNER_ID=
BOT_VERSION=1.0.0
NODE_ENV=production

# ── Webhook ───────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
PORT=3000

# ── Database ──────────────────────────────
DATABASE_URL=
REDIS_URL=

# ── Default / Primary Channel ─────────────
DEFAULT_CHANNEL_ID=

# ── Timezone ──────────────────────────────
DEFAULT_TIMEZONE=Africa/Nairobi

# ── GramJS / MTProto (views tracking) ─────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GRAMJS_SESSION_STRING=
GRAMJS_ENCRYPTION_KEY=

# ── Watchdog ──────────────────────────────
WATCHDOG_ALERT_THRESHOLD=5
WATCHDOG_WINDOW_MINUTES=10
WATCHDOG_QUIET_HOURS_START=23
WATCHDOG_QUIET_HOURS_END=7
WATCHDOG_MEMORY_WARN_MB=360
WATCHDOG_MEMORY_CRITICAL_MB=435
WATCHDOG_POLL_INTERVAL_MINUTES=5

# ── Environment separation (optional) ─────
STAGING_BOT_TOKEN=
STAGING_CHANNEL_ID=
