# ── Core Bot ──────────────────────────────
BOT_TOKEN=
OWNER_ID=
BOT_VERSION=1.0.0
NODE_ENV=production

# ── Webhook ───────────────────────────────
# On Railway, the webhook URL is derived automatically from
# RAILWAY_PUBLIC_DOMAIN (a reference variable Railway injects for services
# with a public network), so you do NOT need to set WEBHOOK_URL there.
# WEBHOOK_URL below is only used as a fallback for local development or
# non-Railway hosts, where RAILWAY_PUBLIC_DOMAIN isn't available.
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
PORT=3000

# ── Database ──────────────────────────────
DATABASE_URL=
REDIS_URL=

# ── Default / Primary Channel ─────────────
DEFAULT_CHANNEL_ID=

# ── Timezone ──────────────────────────────
DEFAULT_TIMEZONE=Africa/Nairobi

# ── GramJS / MTProto (views tracking) ─────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GRAMJS_SESSION_STRING=
GRAMJS_ENCRYPTION_KEY=

# ── Watchdog ──────────────────────────────
WATCHDOG_ALERT_THRESHOLD=5
WATCHDOG_WINDOW_MINUTES=10
WATCHDOG_QUIET_HOURS_START=23
WATCHDOG_QUIET_HOURS_END=7
WATCHDOG_MEMORY_WARN_MB=360
WATCHDOG_MEMORY_CRITICAL_MB=435
WATCHDOG_POLL_INTERVAL_MINUTES=5

# ── Environment separation (optional) ─────
STAGING_BOT_TOKEN=
STAGING_CHANNEL_ID=
